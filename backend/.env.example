# --- Core ---
ENVIRONMENT=development

# SQLite works out of the box (file created next to the backend).
# For production use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/decisioniq
DATABASE_URL=sqlite:///./decisioniq.db

# --- Security ---
# CHANGE THIS in any shared/production environment.
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- AI Provider (Google Gemini Free Tier or OpenAI-compatible) ---
# Get a FREE API key from Google AI Studio in 30 seconds: https://aistudio.google.com/
GEMINI_API_KEY=
# Or use an OpenAI-compatible provider:
# AI_API_KEY=sk-...
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-1.5-flash

# --- Optional research provider (Tavily) ---
# When unset, research uses dynamic keyless web search and Wikipedia API.
# SEARCH_API_KEY=tvly-...

# --- Optional Redis (distributed rate limiting / caching) ---
# REDIS_URL=redis://localhost:6379/0

# --- CORS ---
CORS_ORIGINS=http://localhost:3000